22%20width%3D%22150%22%20height%3D%22150%22%20viewBox%3D%220%200%20150%20150%22%3E%3C%2Fsvg%3E\"><\/span><span class=\"fg-image-overlay\"><\/span><\/a><figcaption class=\"fg-caption\"><div class=\"fg-caption-inner\"><div class=\"fg-caption-title\">Victor Emmanuel II became the first king of a unified Italy in 1870. The inscription reads \"Padre della Patria\" (i.e. Father of the Fatherland).<\/div><\/div><\/figcaption><\/figure><div class=\"fg-loader\"><\/div><\/div><div class=\"fg-item fg-type-image fg-idle\"><figure class=\"fg-item-inner\"><a href=\"https:\/\/www.ibafflatusdesign.space\/wp-content\/uploads\/2017\/04\/DSC_2083.jpg\" data-caption-title=\"Queen Margherita was Umberto I&#039;s wife. It&#039;s after her that the Margherita pizza is named. Have you every noticed how the red tomatoes, the white mozzarella and the green basil make up the colors of the Italian flag?\" data-attachment-id=\"1485\" class=\"fg-thumb\"><span class=\"fg-image-wrap\"><img loading=\"lazy\" decoding=\"async\" title=\"Queen Margherita was Umberto I&#039;s wife. It&#039;s after her that the Margherita pizza is named. Have you every noticed how the red tomatoes, the white mozzarella and the green basil make up the colors of the Italian flag?\" width=\"150\" height=\"150\" class=\"skip-lazy fg-image\" data-src-fg=\"https:\/\/www.ibafflatusdesign.space\/wp-content\/uploads\/cache\/2017\/04\/DSC_2083\/2339224615.jpg\" src=\"data:image\/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%22150%22%20height%3D%22150%22%20viewBox%3D%220%200%20150%20150%22%3E%3C%2Fsvg%3E\"><\/span><span class=\"fg-image-overlay\"><\/span><\/a><figcaption class=\"fg-caption\"><div class=\"fg-caption-inner\"><div class=\"fg-caption-title\">Queen Margherita was Umberto I's wife. It's after her that the Margherita pizza is named. Have you every noticed how the red tomatoes, the white mozzarella and the green basil make up the colors of the Italian flag?<\/div><\/div><\/figcaption><\/figure><div class=\"fg-loader\"><\/div><\/div><\/div>\r\n<\/div>\n<div class=\"su-tabs-pane su-u-clearfix su-u-trim\" data-title=\"Colosseum and the Roman Forums\"> <style type=\"text\/css\">\r\n\t#foogallery-gallery-1501 .fg-image {\r\n        width: 150px;\r\n    }\r\n<\/style>\r\n\t\t\t\t<div class=\"foogallery foogallery-container foogallery-default foogallery-lightbox-foobox-free fg-gutter-10 fg-center fg-default fg-light fg-border-thin fg-shadow-small fg-loading-default fg-loaded-fade-in fg-hover-fade fg-hover-zoom fg-ready\" id=\"foogallery-gallery-1501\" data-foogallery=\"{&quot;item&quot;:{&quot;showCaptionTitle&quot;:true,&quot;showCaptionDescription&quot;:false},&quot;lazy&quot;:true}\" >\r\n\t<div class=\"fg-item fg-type-image fg-idle\"><figure class=\"fg-item-inner\"><a href=\"https:\/\/www.ibafflatusdesign.space\/wp-content\/uploads\/2017\/04\/DSC_2127.jpg\" data-caption-title=\"The Colosseum\u2019s original name is the Flavian Amphitheater. The nickname Colosseum is derived from the statue that used to tower next to the stadium, the Colossus of Nero.\" data-attachment-id=\"1494\" class=\"fg-thumb\"><span class=\"fg-image-wrap\"><img loading=\"lazy\" decoding=\"async\" title=\"The Colosseum\u2019s original name is the Flavian Amphitheater. The nickname Colosseum is derived from the statue that used to tower next to the stadium, the Colossus of Nero.\" width=\"150\" height=\"150\" class=\"skip-lazy fg-image\" data-src-fg=\"https:\/\/www.ibafflatusdesign.space\/wp-content\/uploads\/cache\/2017\/04\/DSC_2127\/3515535022.jpg\" src=\"data:image\/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%22150%22%20height%3D%22150%22%20viewBox%3D%220%200%20150%20150%22%3E%3C%2Fsvg%3E\"><\/span><span class=\"fg-image-overlay\"><\/span><\/a><figcaption class=\"fg-caption\"><div class=\"fg-caption-inner\"><div class=\"fg-caption-title\">The Colosseum\u2019s original name is the Flavian Amphitheater. The nickname Colosseum is derived from the statue that used to tower next to the stadium, the Colossus of Nero.<\/div><\/div><\/figcaption><\/figure><div class=\"fg-loader\"><\/div><\/div><div class=\"fg-item fg-type-image fg-idle\"><figure class=\"fg-item-inner\"><a href=\"https:\/\/www.ibafflatusdesign.space\/wp-content\/uploads\/2017\/04\/DSC_2131.jpg\" data-caption-title=\"The Colosseum took less than 10 years to build. The arena was originally covered with boards and 9 inches of sand. Animals, warriors and stage sets were hoisted up from the underground passage ways through trap doors to the stage on elevators. The arena is almost as big as a football field and the stadium is a third of a mile in diameter. Despite its mammoth size, the stadium could be covered with canvas to protect from sun or rain. The stadium has a capacity of 50,000 people.\" data-attachment-id=\"1426\" class=\"fg-thumb\"><span class=\"fg-image-wrap\"><img loading=\"lazy\" decoding=\"async\" title=\"The Colosseum took less than 10 years to build. The arena was originally covered with boards and 9 inches of sand. Animals, warriors and stage sets were hoisted up from the underground passage ways through trap doors to the stage on elevators. The arena is almost as big as a football field and the stadium is a third of a mile in diameter. Despite its mammoth size, the stadium could be covered with canvas to protect from sun or rain. The stadium has a capacity of 50,000 people.\" width=\"150\" height=\"150\" class=\"skip-lazy fg-image\" data-src-fg=\"https:\/\/www.ibafflatusdesign.space\/wp-content\/uploads\/cache\/2017\/04\/DSC_2131\/1783475233.jpg\" src=\"data:image\/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%22150%22%20height%3D%22150%22%20viewBox%3D%220%200%20150%20150%22%3E%3C%2Fsvg%3E\"><\/span><span class=\"fg-image-overlay\"><\/span><\/a><figcaption class=\"fg-caption\"><div class=\"fg-caption-inner\"><div class=\"fg-caption-title\">The Colosseum took less than 10 years to build. The arena was originally covered with boards and 9 inches of sand. Animals, warriors and stage sets were hoisted up from the underground passage ways through trap doors to the stage on elevators. The arena is almost as big as a football field and the stadium is a third of a mile in diameter. Despite its mammoth size, the stadium could be covered with canvas to protect from sun or rain. The stadium has a capacity of 50,000 people.<\/div><\/div><\/figcaption><\/figure><div class=\"fg-loader\"><\/div><\/div><div class=\"fg-item fg-type-image fg-idle\"><figure class=\"fg-item-inner\"><a href=\"https:\/\/www.ibafflatusdesign.space\/wp-content\/uploads\/2017\/04\/DSC_2130.jpg\" data-caption-title=\"The arena was built in 80 A.D. The building was commemorated by a 100-day festival. During the festival, 2000 men and 9000 animals killed in the battles. To mask the smell of blood, workers periodically sprayed perfume in the stands.\n&lt;p&gt; Typical schedule was animal fights in the morning, criminal executions after lunch and gladiators in the afternoon. Criminal executions were creative in the sense that criminals could be thrown to the lions or dressed up to act out a tragic character from an existing play. Female gladiators, dwarfs and clowns entertained between rounds.&lt;\/p&gt;\" data-attachment-id=\"1425\" class=\"fg-thumb\"><span class=\"fg-image-wrap\"><img loading=\"lazy\" decoding=\"async\" title=\"The arena was built in 80 A.D. The building was commemorated by a 100-day festival. During the festival, 2000 men and 9000 animals killed in the battles. To mask the smell of blood, workers periodically sprayed perfume in the stands.\n&lt;p&gt; Typical schedule was animal fights in the morning, criminal executions after lunch and gladiators in the afternoon. Criminal executions were creative in the sense that criminals could be thrown to the lions or dressed up to act out a tragic character from an existing play. Female gladiators, dwarfs and clowns entertained between rounds.&lt;\/p&gt;\" width=\"150\" height=\"150\" class=\"skip-lazy fg-image\" data-src-fg=\"https:\/\/www.ibafflatusdesign.space\/wp-content\/uploads\/cache\/2017\/04\/DSC_2130\/2482705446.jpg\" src=\"data:image\/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%22150%22%20height%3D%22150%22%20viewBox%3D%220%200%20150%20150%22%3E%3C%2Fsvg%3E\"><\/span><span class=\"fg-image-overlay\"><\/span><\/a><figcaption class=\"fg-caption\"><div class=\"fg-caption-inner\"><div class=\"fg-caption-title\">The arena was built in 80 A.D. The building was commemorated by a 100-day festival. During the festival, 2000 men and 9000 animals killed in the battles. To mask the smell of blood, workers periodically sprayed perfume in the stands.\n<p> Typical schedule was animal fights in the morning, criminal executions after lunch and gladiators in the afternoon. Criminal executions were creative in the sense that criminals could be thrown to the lions or dressed up to act out a tragic character from an existing play. Female gladiators, dwarfs and clowns entertained between rounds.<\/p><\/div><\/div><\/figcaption><\/figure><div class=\"fg-loader\"><\/div><\/div><div class=\"fg-item fg-type-image fg-idle\"><figure class=\"fg-item-inner\"><a href=\"https:\/\/www.ibafflatusdesign.space\/wp-content\/uploads\/2017\/04\/DSC_2128.jpg\" data-caption-title=\"Gladiators usually came from the lowest classes. Slaves, criminals and prisoners of war fought for freedom or for fame. Gladiators were the celebrities of ancient roman times. In a warrior society, these bloodthirsty games played straight into the society\u2019s values. The gladiator conquests over lions reminded spectators of human\u2019s conquest over nature. The presence of exotic animals from Africa reminded the people of the Empire\u2019s foreign conquests.\" data-attachment-id=\"1495\" class=\"fg-thumb\"><span class=\"fg-image-wrap\"><img loading=\"lazy\" decoding=\"async\" title=\"Gladiators usually came from the lowest classes. Slaves, criminals and prisoners of war fought for freedom or for fame. Gladiators were the celebrities of ancient roman times. In a warrior society, these bloodthirsty games played straight into the society\u2019s values. The gladiator conquests over lions reminded spectators of human\u2019s conquest over nature. The presence of exotic animals from Africa reminded the people of the Empire\u2019s foreign conquests.\" width=\"150\" height=\"150\" class=\"skip-lazy fg-image\" data-src-fg=\"https:\/\/www.ibafflatusdesign.space\/wp-content\/uploads\/cache\/2017\/04\/DSC_2128\/2909910602.jpg\" src=\"data:image\/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%22150%22%20height%3D%22150%22%20viewBox%3D%220%200%20150%20150%22%3E%3C%2Fsvg%3E\"><\/span><span class=\"fg-image-overlay\"><\/span><\/a><figcaption class=\"fg-caption\"><div class=\"fg-caption-inner\"><div class=\"fg-caption-title\">Gladiators usually came from the lowest classes. Slaves, criminals and prisoners of war fought for freedom or for fame. Gladiators were the celebrities of ancient roman times. In a warrior society, these bloodthirsty games played straight into the society\u2019s values. The gladiator conquests over lions reminded spectators of human\u2019s conquest over nature. The presence of exotic animals from Africa reminded the people of the Empire\u2019s foreign conquests.<\/div><\/div><\/figcaption><\/figure><div class=\"fg-loader\"><\/div><\/div><div class=\"fg-item fg-type-image fg-idle\"><figure class=\"fg-item-inner\"><a href=\"https:\/\/www.ibafflatusdesign.space\/wp-content\/uploads\/2017\/04\/DSC_2139.jpg\" data-caption-title=\"When the Church was taken over by the church in 1749, Pope Benedict XIV declared that it was a sacred site where early Christians had given their lives. To honor those martyrs, a cross was installed on the north side of the Colosseum, where the emperor\u2019s box is said to have been.\" data-attachment-id=\"1429\" class=\"fg-thumb\"><span class=\"fg-image-wrap\"><img loading=\"lazy\" decoding=\"async\" title=\"When the Church was taken over by the church in 1749, Pope Benedict XIV declared that it was a sacred site where early Christians had given their lives. To honor those martyrs, a cross was installed on the north side of the Colosseum, where the emperor\u2019s box is said to have been.\" width=\"150\" height=\"150\" class=\"skip-lazy fg-image\" data-src-fg=\"https:\/\/www.ibafflatusdesign.space\/wp-content\/uploads\/cache\/2017\/04\/DSC_2139\/1489431913.jpg\" src=\"data:image\/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%22150%22%20height%3D%22150%22%20viewBox%3D%220%200%20150%20150%22%3E%3C%2Fsvg%3E\"><\/span><span class=\"fg-image-overlay\"><\/span><\/a><figcaption class=\"fg-caption\"><div class=\"fg-caption-inner\"><div class=\"fg-caption-title\">When the Church was taken over by the church in 1749, Pope Benedict XIV declared that it was a sacred site where early Christians had given their lives. To honor those martyrs, a cross was installed on the north side of the Colosseum, where the emperor\u2019s box is said to have been.<\/div><\/div><\/figcaption><\/figure><div class=\"fg-loader\"><\/div><\/div><div class=\"fg-item fg-type-image fg-idle\"><figure class=\"fg-item-inner\"><a href=\"https:\/\/www.ibafflatusdesign.space\/wp-content\/uploads\/2017\/04\/DSC_2135_edit.jpg\" data-caption-title=\"In 312 A.D., the Emperor Constantine saw a cross in the sky the day before the Battle of the Milvian Bridge. This Arch of Constantine is said to celebrate Constantine\u2019s victory. Yet, the Emperor attributed his victory to the holy power he had seen the day before. Since then, Christianity was the sanctioned religion by the Empire. The introduction of the new religion marked the decline of the Colosseum games as they were deemed immoral. Yet, it wasn\u2019t until 523 that the doors of the Colosseum were officially shut. Over time, the building was eroded by nature but also by its people. Romans took metal and stones from the Colosseum in order to build other palaces and churches, including St. Peter\u2019s Basilica.\" data-attachment-id=\"1511\" class=\"fg-thumb\"><span class=\"fg-image-wrap\"><img loading=\"lazy\" decoding=\"async\" title=\"In 312 A.D., the Emperor Constantine saw a cross in the sky the day before the Battle of the Milvian Bridge. This Arch of Constantine is said to celebrate Constantine\u2019s victory. Yet, the Emperor attributed his victory to the holy power he had seen the day before. Since then, Christianity was the sanctioned religion by the Empire. The introduction of the new religion marked the decline of the Colosseum games as they were deemed immoral. Yet, it wasn\u2019t until 523 that the doors of the Colosseum were officially shut. Over time, the building was eroded by nature but also by its people. Romans took metal and stones from the Colosseum in order to build other palaces and churches, including St. Peter\u2019s Basilica.\" width=\"150\" height=\"150\" class=\"skip-lazy fg-image\" data-src-fg=\"https:\/\/www.ibafflatusdesign.space\/wp-content\/uploads\/cache\/2017\/04\/DSC_2135_edit\/1110961834.jpg\" src=\"data:image\/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%22150%22%20height%3D%22150%22%20viewBox%3D%220%200%20150%20150%22%3E%3C%2Fsvg%3E\"><\/span><span class=\"fg-image-overlay\"><\/span><\/a><figcaption class=\"fg-caption\"><div class=\"fg-caption-inner\"><div class=\"fg-caption-title\">In 312 A.D., the Emperor Constantine saw a cross in the sky the day before the Battle of the Milvian Bridge. This Arch of Constantine is said to celebrate Constantine\u2019s victory. Yet, the Emperor attributed his victory to the holy power he had seen the day before. Since then, Christianity was the sanctioned religion by the Empire. The introduction of the new religion marked the decline of the Colosseum games as they were deemed immoral. Yet, it wasn\u2019t until 523 that the doors of the Colosseum were officially shut. Over time, the building was eroded by nature but also by its people. Romans took metal and stones from the Colosseum in order to build other palaces and churches, including St. Peter\u2019s Basilica.<\/div><\/div><\/figcaption><\/figure><div class=\"fg-loader\"><\/div><\/div><div class=\"fg-item fg-type-image fg-idle\"><figure class=\"fg-item-inner\"><a href=\"https:\/\/www.ibafflatusdesign.space\/wp-content\/uploads\/2017\/04\/DSC_2145.jpg\" data-caption-title=\"The Palatine Hill is one of the seven hills of Rome. According to Roman mythology, Romulus and Remus were found on the hill after being cared for by a she-wolf. Romulus is said to have come back and established the city of Rome on this hill. Later, the Emperor Augustus was born and raised here. While Emperor Augustus\u2019 residence was rather modest for his status, future Emperor\u2019s built large residences on this hill. The palaces left in the best shape are the remains of Domus Augustana (pictured here) and Domus Flavia. In fact, the word &lt;i&gt; palace&lt;\/i&gt; comes from the large residences built on the &lt;i&gt;Paletine&lt;\/i&gt; Hill.\" data-attachment-id=\"1509\" class=\"fg-thumb\"><span class=\"fg-image-wrap\"><img loading=\"lazy\" decoding=\"async\" title=\"The Palatine Hill is one of the seven hills of Rome. According to Roman mythology, Romulus and Remus were found on the hill after being cared for by a she-wolf. Romulus is said to have come back and established the city of Rome on this hill. Later, the Emperor Augustus was born and raised here. While Emperor Augustus\u2019 residence was rather modest for his status, future Emperor\u2019s built large residences on this hill. The palaces left in the best shape are the remains of Domus Augustana (pictured here) and Domus Flavia. In fact, the word &lt;i&gt; palace&lt;\/i&gt; comes from the large residences built on the &lt;i&gt;Paletine&lt;\/i&gt; Hill.\" width=\"150\" height=\"150\" class=\"skip-lazy fg-image\" data-src-fg=\"https:\/\/www.ibafflatusdesign.space\/wp-content\/uploads\/cache\/2017\/04\/DSC_2145\/260790511.jpg\" src=\"data:image\/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%22150%22%20height%3D%22150%22%20viewBox%3D%220%200%20150%20150%22%3E%3C%2Fsvg%3E\"><\/span><span class=\"fg-image-overlay\"><\/span><\/a><figcaption class=\"fg-caption\"><div class=\"fg-caption-inner\"><div class=\"fg-caption-title\">The Palatine Hill is one of the seven hills of Rome. According to Roman mythology, Romulus and Remus were found on the hill after being cared for by a she-wolf. Romulus is said to have come back and established the city of Rome on this hill. Later, the Emperor Augustus was born and raised here. While Emperor Augustus\u2019 residence was rather modest for his status, future Emperor\u2019s built large residences on this hill. The palaces left in the best shape are the remains of Domus Augustana (pictured here) and Domus Flavia. In fact, the word <i> palace<\/i> comes from the large residences built on the <i>Paletine<\/i> Hill.<\/div><\/div><\/figcaption><\/figure><div class=\"fg-loader\"><\/div><\/div><div class=\"fg-item fg-type-image fg-idle\"><figure class=\"fg-item-inner\"><a href=\"https:\/\/www.ibafflatusdesign.space\/wp-content\/uploads\/2017\/04\/DSC_2149.jpg\" data-caption-title=\"Back in the Roman Forums, you can spot the large Basilica of Maxintius and Constantine. The Basilica served as the hall of justice and was used for business. Its construction was ordered by Maxentius, who was murdered by Constantine before it was completed. The Basilica serves as the model for Christian churches, with two columns of seats and a walkway in the middle.\" data-attachment-id=\"1431\" class=\"fg-thumb\"><span class=\"fg-image-wrap\"><img loading=\"lazy\" decoding=\"async\" title=\"Back in the Roman Forums, you can spot the large Basilica of Maxintius and Constantine. The Basilica served as the hall of justice and was used for business. Its construction was ordered by Maxentius, who was murdered by Constantine before it was completed. The Basilica serves as the model for Christian churches, with two columns of seats and a walkway in the middle.\" width=\"150\" height=\"150\" class=\"skip-lazy fg-image\" data-src-fg=\"https:\/\/www.ibafflatusdesign.space\/wp-content\/uploads\/cache\/2017\/04\/DSC_2149\/1787417583.jpg\" src=\"data:image\/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%22150%22%20height%3D%22150%22%20viewBox%3D%220%200%20150%20150%22%3E%3C%2Fsvg%3E\"><\/span><span class=\"fg-image-overlay\"><\/span><\/a><figcaption class=\"fg-caption\"><div class=\"fg-caption-inner\"><div class=\"fg-caption-title\">Back in the Roman Forums, you can spot the large Basilica of Maxintius and Constantine. The Basilica served as the hall of justice and was used for business. Its construction was ordered by Maxentius, who was murdered by Constantine before it was completed. The Basilica serves as the model for Christian churches, with two columns of seats and a walkway in the middle.<\/div><\/div><\/figcaption><\/figure><div class=\"fg-loader\"><\/div><\/div><div class=\"fg-item fg-type-image fg-idle\"><figure class=\"fg-item-inner\"><a href=\"https:\/\/www.ibafflatusdesign.space\/wp-content\/uploads\/2017\/04\/DSC_2151.jpg\" data-caption-title=\"The Temple of Romulus, named after the creator of Rome, was built in 307 A.D. by Emperor Maxentius in honor of his son who died as a child. The green copper doors on this building are completely original.\" data-attachment-id=\"1432\" class=\"fg-thumb\"><span class=\"fg-image-wrap\"><img loading=\"lazy\" decoding=\"async\" title=\"The Temple of Romulus, named after the creator of Rome, was built in 307 A.D. by Emperor Maxentius in honor of his son who died as a child. The green copper doors on this building are completely original.\" width=\"150\" height=\"150\" class=\"skip-lazy fg-image\" data-